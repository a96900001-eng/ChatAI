/* ---------------------------------------------------------------------
   BACKEND URL
   Change this to wherever you deploy the /backend folder that ships
   alongside this file.
   - Local web dev:            http://localhost:4000
   - Android emulator ->host:  http://10.0.2.2:4000
   - Real device / production: https://your-api-domain.com  (MUST be
     HTTPS — Android 9+ blocks plain HTTP by default, and Apple/Google
     both require it for a Play Store / App Store submission)
--------------------------------------------------------------------- */
const API_BASE = (import.meta.env.VITE_API_BASE || "http://localhost:4000").replace(/\/$/, "");

/* ---------------------------------------------------------------------
   TOKEN STORAGE
   Uses localStorage on web. This throws inside the Claude.ai artifact
   preview sandbox (browser storage is disabled there), so login won't
   survive a refresh *in this preview* — that's expected. Once you run
   this file in your own project (Vite/CRA) or wrap it with Capacitor,
   storage works normally and the session will persist for real.

   For the Capacitor/Android build specifically, swap this for
   @capacitor/preferences instead of localStorage — it's the supported,
   more secure native storage API and avoids WebView storage quirks:
     import { Preferences } from '@capacitor/preferences';
     await Preferences.set({ key: 'chatai_token', value: token });
--------------------------------------------------------------------- */
let memoryToken = null; // fallback so the preview doesn't crash
const tokenStorage = {
  get() {
    try {
      return localStorage.getItem("chatai_token");
    } catch {
      return memoryToken;
    }
  },
  set(token) {
    try {
      localStorage.setItem("chatai_token", token);
    } catch {
      memoryToken = token;
    }
  },
  clear() {
    try {
      localStorage.removeItem("chatai_token");
    } catch {
      memoryToken = null;
    }
  },
};

async function apiFetch(path, options = {}) {
  const token = tokenStorage.get();
  const res = await fetch(`${API_BASE}${path}`, {
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...(options.headers || {}),
    },
  });
  let data = {};
  try {
    data = await res.json();
  } catch {
    // no body
  }
  if (!res.ok) {
    throw new Error(data.error || `Request failed (${res.status})`);
  }
  return data;
}

function Avatar({ role }) {
  if (role === "user") {
    return (
      <div
        style={{ background: COLORS.teal }}
        className="w-8 h-8 rounded-full flex items-center justify-center text-xs font-semibold text-black shrink-0"
      >
        AP
      </div>
    );
  }
  return (
    <div
      style={{ background: COLORS.amber }}
      className="w-8 h-8 rounded-full flex items-center justify-center shrink-0"
    >
      <Sparkles size={16} color="#12151A" />
    </div>
